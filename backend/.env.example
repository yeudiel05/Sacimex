# ============================================================
# SACIMEX — Variables de entorno del servidor
# ============================================================
# Copia este archivo como ".env" y rellena los valores reales.
# El archivo .env NUNCA debe subirse al repositorio (ya está en .gitignore).

# ── Base de datos MySQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=sacimex

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# ── Correo electrónico (SMTP) ────────────────────────────────
# Opción A — Gmail con Contraseña de Aplicación (recomendado):
#   1. Activa la verificación en 2 pasos en la cuenta de Google.
#   2. Ve a: Cuenta de Google → Seguridad → Contraseñas de aplicación.
#   3. Crea una contraseña para "Correo" / "Otro dispositivo".
#   4. Usa esa contraseña de 16 caracteres en SMTP_PASS.
#
# Opción B — Otro proveedor (Outlook, Zoho, SMTP propio):
#   Cambia SMTP_HOST, SMTP_PORT y SMTP_SECURE según tu proveedor.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=correo_institucional@sacimex.com.mx
SMTP_PASS=contraseña_de_aplicacion_16_caracteres
SMTP_FROM="Sacimex Sistema" <correo_institucional@sacimex.com.mx>

# ── Puerto del servidor Node ─────────────────────────────────
PORT=3001